# Copiar este archivo a terraform.tfvars y ajustar valores.
# NUNCA commitear terraform.tfvars ni archivos .tfstate al repositorio.

project_name       = "devops-pipeline-demo"
environment        = "dev"
aws_region         = "us-east-1"
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]
cluster_version    = "1.29"
node_instance_type = "t3.medium"
node_min_size      = 1
node_max_size      = 4
node_desired_size  = 2
